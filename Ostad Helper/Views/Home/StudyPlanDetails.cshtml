@model List<Ostad_Helper.Models.StudyPlanDetailsRoot>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Content"] = "Exam Schedules";
    var bdTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Bangladesh Standard Time");
    var nowBD = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, bdTimeZone);
}

<div class="container-fluid">
<div class="col-md-12">
    <div class="card mb-12">
            <div class="card-header border-0">
                <h5 class="card-title">Schedules for Assignments, Quizzes, Live Exams, and Projects</h5>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                    <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                    <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                </button>
            </div>
        </div>
        <!-- /.card-header -->
        <div class="card-body" style="box-sizing: border-box; display: block;">
            <!--begin::Row-->
            <div class="row">
                <table id="studyPlanTable" class="table table-bordered table-striped dataTable dtr-inline">
                    <thead>
                        <tr>
                            <th>
                                Course Title
                            </th>
                            <th>
                                Module
                            </th>
                            <th>
                                Module URL
                            </th>
                            <th>
                                Type
                            </th>

                            <th>
                                Duration
                            </th>

                            <th>
                                Start Date
                            </th>
                            <th>
                                Last Date
                            </th>
                            <th>
                                Status
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var modeldata in Model)
                        {

                            @foreach (var item in modeldata.data.timeline
                           .Where(x => new[] { "quiz", "assignment", "practice_coding_test", "project", "written" }
                           // .Contains(x.type)).OrderBy(x => x.is_late_submission).Where(p => (p.last_submission_date > DateTime.UtcNow && p.last_submission_date < DateTime.UtcNow.AddDays(7)) || (p.submission_start_date < DateTime.UtcNow && p.submission_start_date > DateTime.UtcNow.AddDays(7))))
                           .Contains(x.type)).OrderBy(x => x.is_late_submission)
                           )



                            {

                                DateTime? startBD = item.submission_start_date.HasValue
                                ? TimeZoneInfo.ConvertTime(item.submission_start_date.Value, bdTimeZone).DateTime
                                : (DateTime?)null;

                                DateTime? endBD = item.last_submission_date.HasValue
                                ? TimeZoneInfo.ConvertTime(item.last_submission_date.Value, bdTimeZone).DateTime
                                : (DateTime?)null;

                                string status;

                                if (item.has_completed == true)
                                {
                                    status = "Completed";
                                }
                                else if (!endBD.HasValue)
                                {
                                    status = startBD.HasValue && nowBD < startBD ? "Upcoming" : "Expired";
                                }
                                else if (startBD.HasValue && endBD.HasValue)
                                {
                                    status = nowBD < startBD ? "Upcoming"
                                    : nowBD <= endBD ? "Ongoing"
                                    : "Expired";
                                }
                                else
                                {
                                    status = "";
                                }
                                <tr class="">
                                    <td>
                                        @modeldata.data.batch.course_snapshot.title
                                    </td>
                                    <td>
                                        @modeldata.data.title
                                    </td>
                                    <td><a href="https://ostad.app/dashboard/my-courses/@item.batch/module/@item.study_plan" target="_blank">@item.title</a></td>
                                    <td>
                                        @item.type
                                    </td>
                                    <td>
                                        @item.duration
                                    </td>

                                    <td>
                                        @startBD
                                    </td>
                                    <td>
                                        @endBD

                                    </td>

                                    <td>@status</td>

                                </tr>

                            }


                        }
                    </tbody>
                </table>
            </div>
            <!--end::Row-->
        </div>
        <!-- ./card-body -->
    </div>
    <!-- /.card -->
</div>


</div>
<div>
</div>
@section scripts{
    <script>
        $(document).ready(function () {
           
            $('#studyPlanTable').DataTable({
                pageLength: 6,
                order: [], // disable initial sort
                responsive: true,
                language: {
                    searchPlaceholder: "Search modules or types..."
                }
            });
        });
    </script>
}

