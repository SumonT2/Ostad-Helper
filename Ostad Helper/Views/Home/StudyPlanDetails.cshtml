@model List<Ostad_Helper.Models.StudyPlanDetailsRoot>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Courses</h3>

<div class="container-fluid">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>
                    Title
                </th>
                <th>
                    Type
                </th>
                <th>
                    Has Completed
                </th>
                <th>
                    Grace Period Over
                </th>

                <th>


                    Duration
                </th>

                <th>
                    Start Date
                </th>
                <th>
                    Last Date
                </th>

            </tr>
        </thead>
        <tbody>
            @foreach (var modeldata in Model)
            {
                
                @foreach (var item in modeldata.data.timeline
                            .Where(x => new[] { "quiz", "assignment", "practice_coding_test", "project", "written" }
              // .Contains(x.type)).OrderBy(x => x.is_late_submission).Where(p => (p.last_submission_date > DateTime.UtcNow && p.last_submission_date < DateTime.UtcNow.AddDays(7)) || (p.submission_start_date < DateTime.UtcNow && p.submission_start_date > DateTime.UtcNow.AddDays(7))))
               .Contains(x.type)).OrderBy(x => x.is_late_submission)
               )

                {
                    <tr class="">
                        @*  <td>
                        @item._id
                    </td>
                    <td>
                        @item.batch
                    </td>
                    <td>
                        @item.study_plan
                    </td> *@
                        <td>
                            @modeldata.data.batch.course_snapshot.title
                        </td>
                        <td>
                            @modeldata.data.title
                        </td>
                        <td><a href="https://ostad.app/dashboard/my-courses/@item.batch/module/@item.study_plan" target="_blank">@item.title</a></td>
                        <td>
                            @item.type
                        </td>

                        <td>
                            @item.has_completed
                        </td>
                        <td>
                            @item.grace_period_over
                        </td>
                        <td>
                            @item.duration
                        </td>

                        <td>
                            @item.submission_start_date
                        </td>
                        <td>
                            @item.last_submission_date
                        </td>


                    </tr>
                    
                }

               
            }
        </tbody>
    </table>
</div>
<div>
</div>
