@model List<Ostad_Helper.Models.BatchResult>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Content"] = "Course List";
}

<div class="col-md-12">
    <div class="card mb-12">
        <div class="card-header border-0">
            <h5 class="card-title">List of all Courses</h5>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                    <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                    <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                </button>
            </div>
        </div>
        <!-- /.card-header -->
        <div class="card-body" style="box-sizing: border-box; display: block;">
            <!--begin::Row-->
            <div class="row">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>
                                Course Code
                            </th>
                            <th>
                                Course Title
                            </th>
                            <th>
                                Class Routine
                            </th>
                            <th>
                                Status
                            </th>
                            <th>
                                Duration
                            </th>
                            <th>
                                Day Count
                            </th>
                            <th>Learners</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string duration;
                            <tr class="">
                                <td>
                                    @item.batch_code
                                </td>

                                <td>
                                    @item.course_snapshot.title
                                </td>

                                <td>

                                    @string.Join(", ", item.class_days)

                                </td>
                                <td>@item.status</td>
                                <td>@item.course_snapshot.duration.count @item.course_snapshot.duration.unit</td>

                          @*       @if (item.course_snapshot.duration.unit == "months")
                                {
                                    int months = (int)item.count_days / 30;
                                    int days = (int)item.count_days % 30;
                                    string monthText = months == 1 ? "month" : "months";
                                    string dayText = days == 1 ? "day" : "days";
                                    duration = months+" "+monthText + " " +days+" "+ dayText;
                                }
                                else
                                {
                                    string dayText = (int)item.count_days == 1 ? "day" : "days";
                                    duration = (int)item.count_days + " " + dayText;
                                } 
                                <td>
                                    @duration
                                </td>*@
                                <td>@item.count_learners</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <!--end::Row-->
        </div>
        <!-- ./card-body -->
    </div>
    <!-- /.card -->
</div>

<div>
</div>
